# Copy thành .env để đổi thông tin DB / RabbitMQ / MinIO (compose tự đọc). Không có .env thì dùng giá trị mặc định bên dưới.
POSTGRES_DB=file_service
POSTGRES_USER=file_service
POSTGRES_PASSWORD=secret
RABBITMQ_USER=file_service
RABBITMQ_PASSWORD=secret
MINIO_USER=file_service
MINIO_PASSWORD=file_service_secret
