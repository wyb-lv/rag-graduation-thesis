# Biến môi trường toàn hệ thống – copy thành .env và chỉnh sửa
# cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=file_service
POSTGRES_USER=file_service
POSTGRES_PASSWORD=change_me_postgres

# ── Auth Service ──────────────────────────────────────────────────────────────
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=change_me_auth_db
# Secret ký JWT, tối thiểu 32 ký tự
c=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Seed admin/manager/employee1/employee2 (mật khẩu xem DataSeeder.java). Đặt false ở môi trường thật
AUTH_SEED_ENABLED=true
AUTH_RPS=5

# ── RabbitMQ (dùng chung file-service + ai-service) ──────────────────────────
RABBITMQ_USER=hsu
RABBITMQ_PASSWORD=change_me_rabbitmq

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_USER=hsu
MINIO_PASSWORD=change_me_minio

# ── MongoDB (lịch sử hội thoại) ───────────────────────────────────────────────
# Chỉ áp dụng khi volume kltn_mongo_data còn trống; đổi sau đó phải xóa volume hoặc đổi user trong mongosh.
# Compass: mongodb://MONGO_USER:MONGO_PASSWORD@localhost:27017/?authSource=admin (ký tự đặc biệt phải URL-encode)
MONGO_USER=hsu
MONGO_PASSWORD=change_me_mongo

# ── AI Service (đặt trong ai-service/.env để không commit API key) ────────────
# API_KEY=gsk_...
# GROQ_QWEN_MODEL=qwen/qwen3.8-27b
# STT_MODEL=whisper-large-v3

# ── API Gateway ───────────────────────────────────────────────────────────────
GATEWAY_PORT=9090
# Origins FE được phép gọi Gateway (phân cách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
# Rate limit (requests/second)
AI_RPS=10
FILE_RPS=20

# ── Embed pipeline ────────────────────────────────────────────────────────────
# Tắt để không tự động embed sau OCR (có thể embed thủ công qua POST /api/documents/{id}/embed)
EMBED_ENABLED=true

# ── Qdrant volume ─────────────────────────────────────────────────────────────
# Nếu đang dùng volume tên "model_qdrant_storage" từ trước, giữ nguyên để không mất dữ liệu:
# QDRANT_VOLUME=model_qdrant_storage
QDRANT_VOLUME=hsu_qdrant_data
