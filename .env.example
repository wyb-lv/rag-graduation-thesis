# Biến môi trường toàn hệ thống – copy thành .env và chỉnh sửa
# cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=file_service
POSTGRES_USER=file_service
POSTGRES_PASSWORD=change_me_postgres

# ── Auth Service ──────────────────────────────────────────────────────────────
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=change_me_auth_db
# Secret ký JWT, tối thiểu 32 ký tự
c=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
AUTH_RPS=5

# ── Account Service (DB riêng; auth-service chỉ gọi qua gRPC) ─────────────────
ACCOUNT_DB_USER=postgres
ACCOUNT_DB_PASSWORD=change_me_account_db
# Seed admin/employee1/employee2/demo_hsu (mật khẩu xem account-service DataSeeder.java): cách duy nhất tạo Admin đầu tiên.
# Đặt false ở môi trường thật. (Tên cũ AUTH_SEED_ENABLED vẫn được nhận nếu ACCOUNT_SEED_ENABLED chưa đặt.)
ACCOUNT_SEED_ENABLED=true

# ── RabbitMQ (dùng chung file-service + ai-service) ──────────────────────────
RABBITMQ_USER=hsu
RABBITMQ_PASSWORD=change_me_rabbitmq

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_USER=hsu
MINIO_PASSWORD=change_me_minio

# ── MongoDB (lịch sử hội thoại) ───────────────────────────────────────────────
# Chỉ áp dụng khi volume kltn_mongo_data còn trống; đổi sau đó phải xóa volume hoặc đổi user trong mongosh.
# Compass: mongodb://MONGO_USER:MONGO_PASSWORD@localhost:27018/?authSource=admin (cổng MONGO_HOST_PORT, mặc định 27018; ký tự đặc biệt phải URL-encode)
MONGO_USER=hsu
MONGO_PASSWORD=change_me_mongo

# ── AI Service (đặt trong ai-service/.env để không commit API key) ────────────
# GROQ_API_KEY=gsk_...
# GROQ_QWEN_MODEL=qwen/qwen3.8-27b
# STT_MODEL=whisper-large-v3

# ── API Gateway ───────────────────────────────────────────────────────────────
GATEWAY_PORT=9090
# Origins FE được phép gọi Gateway (phân cách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
# Rate limit (requests/second)
AI_RPS=10
FILE_RPS=20

# ── Qdrant volume ─────────────────────────────────────────────────────────────
# Nếu đang dùng volume tên "model_qdrant_storage" từ trước, giữ nguyên để không mất dữ liệu:
# QDRANT_VOLUME=model_qdrant_storage
QDRANT_VOLUME=hsu_qdrant_data

# OCR: image chinh thuc cua PaddleOCR-VL-1.6 (docker-compose.yml). Mac dinh la ban moi nhat; ghim de build lap lai duoc, vd paddleocr3.6-nvidia-gpu-offline
# PADDLEOCR_IMAGE_TAG=latest-nvidia-gpu-offline
# VRAM cua vLLM (ti le tong VRAM, mac dinh 0.6) va so yeu cau song song; GPU nho (4GB) can chia voi ai-service
# OCR_VLM_GPU_UTIL=0.6
# OCR_VLM_MAX_SEQS=16
