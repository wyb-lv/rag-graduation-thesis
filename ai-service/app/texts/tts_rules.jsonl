{"pattern": "\\bĐBCL\\b", "replace": "Đảm bảo chất lượng"}
{"pattern": "\\bTNSV\\b", "replace": "Trải nghiệm sinh viên"}
{"pattern": "\\bQHDN\\b", "replace": "Quan hệ doanh nghiệp"}
{"pattern": "\\bTP\\.\\s*Hồ\\s+Chí\\s+Minh\\b", "replace": "Thành phố Hồ Chí Minh", "ignorecase": true}
{"pattern": "\\bTP\\.\\s*HCM\\b", "replace": "Thành phố Hồ Chí Minh", "ignorecase": true}
{"pattern": "\\bTPHCM\\b", "replace": "Thành phố Hồ Chí Minh", "ignorecase": true}
# Bieu mau va chuoi viet tat ghep hoc vu (dai dat truoc ngan)
{"pattern": "\\bBM_?0?(\\d+[A-Z]?)\\s*/\\s*(?=(?:TTTL|CVHT)\\b)", "replace": "biểu mẫu \\1 "}
{"pattern": "\\bBM_?0?(\\d+[A-Z]?)\\b", "replace": "biểu mẫu \\1"}
{"pattern": "\\bTTNT\\s*[-/]\\s*TTNN\\b", "replace": "thực tập nhận thức và thực tập nghề nghiệp"}
