{"pattern": "\\bBộ\\s+GD\\s*&\\s*ĐT\\b", "replace": "Bộ Giáo dục và Đào tạo"}
{"pattern": "\\bBGD\\s*&?\\s*ĐT\\b", "replace": "Bộ Giáo dục và Đào tạo"}
{"pattern": "\\bĐHHS\\b", "replace": "Đại học Hoa Sen"}
{"pattern": "\\bHSU\\b", "replace": "Đại học Hoa Sen"}
{"pattern": "\\bĐTĐH\\b", "replace": "Đào tạo đại học"}
{"pattern": "\\bBGH\\b", "replace": "Ban Giám hiệu"}
