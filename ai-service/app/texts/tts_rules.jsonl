{"pattern": "\\bP\\.\\s*ĐTĐH\\b", "replace": "Phòng Đào tạo đại học"}
{"pattern": "\\bP\\.\\s*ĐT\\b", "replace": "Phòng Đào tạo"}
{"pattern": "\\bP\\.\\s*TC-?KT\\b", "replace": "Phòng Tài chính Kế toán"}
{"pattern": "\\bTC-KT\\b", "replace": "Tài chính Kế toán"}
{"pattern": "\\bP\\.\\s*KTTC\\b", "replace": "Phòng Kế toán Tài chính"}
{"pattern": "\\bP\\.\\s*HCNS\\b", "replace": "Phòng Hành chính Nhân sự"}
