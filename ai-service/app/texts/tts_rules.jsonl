{"pattern": "\\bSV\\s*/\\s*HV\\b", "replace": "sinh viên hoặc học viên"}
# Viet tat hoc vu don le
{"pattern": "\\bSV\\b", "replace": "sinh viên"}
{"pattern": "\\bGV\\b", "replace": "giảng viên"}
