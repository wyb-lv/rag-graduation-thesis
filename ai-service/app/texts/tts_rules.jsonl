# Chuan hoa van ban hoc vu truoc khi doc bang TTS (chay tuan tu). Dinh dang dong nhu stt_phonetic_rules.jsonl.
# Tach so quyet dinh / thong tu co dau gach cheo truoc khi mo rong ma van ban
{"pattern": "\\b(\\d+)\\s*/\\s*(\\d{4})\\s*/\\s*(?=(?:TT|NĐ|QĐ|VBHN)-)", "replace": "\\1 năm \\2 "}
{"pattern": "\\b(\\d+)\\s*/\\s*(?=(?:QĐ|TB|NQ|TT|VBHN|NĐ|QC)-)", "replace": "\\1 "}
# Ky hieu phap quy / van ban hanh chinh HSU & Bo GDDT (chuoi ghep dai dat truoc chuoi con)
{"pattern": "\\bQĐ\\s*-\\s*ĐHHS\\b", "replace": "Quyết định Đại học Hoa Sen"}
{"pattern": "\\bTB-ĐHHS\\b", "replace": "Thông báo Đại học Hoa Sen"}
{"pattern": "\\bTB-ĐTĐH\\b", "replace": "Thông báo Phòng Đào tạo đại học"}
{"pattern": "\\bNQ-ĐHHS\\b", "replace": "Nghị quyết Đại học Hoa Sen"}
{"pattern": "\\bQĐ-BGH\\b", "replace": "Quyết định Ban Giám hiệu"}
{"pattern": "\\bQĐ-BGDĐT\\b", "replace": "Quyết định Bộ Giáo dục và Đào tạo"}
{"pattern": "\\bTT-BGDĐT\\b", "replace": "Thông tư Bộ Giáo dục và Đào tạo"}
{"pattern": "\\bVBHN-BGDĐT\\b", "replace": "Văn bản hợp nhất Bộ Giáo dục và Đào tạo"}
{"pattern": "\\bNĐ-CP\\b", "replace": "Nghị định Chính phủ"}
{"pattern": "\\bQĐ-TTg\\b", "replace": "Quyết định Thủ tướng Chính phủ"}
{"pattern": "\\bQĐ-UBND\\b", "replace": "Quyết định Ủy ban nhân dân"}
{"pattern": "\\bQC-ĐTĐH\\b", "replace": "Quy chế Đào tạo trình độ đại học"}
{"pattern": "\\bQC-CVHT\\b", "replace": "Quy chế Cố vấn học tập"}
{"pattern": "\\bQC-TSĐH\\b", "replace": "Quy chế Tuyển sinh đại học"}
{"pattern": "\\bQC-NH\\b", "replace": "Quy chế Người học"}
{"pattern": "\\bQC-HB\\b", "replace": "Quy chế Học bổng"}
{"pattern": "\\bQC-ĐRL\\b", "replace": "Quy chế Điểm rèn luyện"}
# Don vi, phong ban, trung tam, hoi dong HSU (dat truoc cac tu viet tat ngan)
{"pattern": "\\bTT\\.\\s*TNSV\\s*&\\s*QHDN\\b", "replace": "Trung tâm Trải nghiệm sinh viên và Quan hệ doanh nghiệp"}
{"pattern": "\\bTNSV\\s*&\\s*QHDN\\b", "replace": "Trải nghiệm sinh viên và Quan hệ doanh nghiệp"}
{"pattern": "\\bTT\\.\\s*TT\\s*&\\s*TN-VLSV\\b", "replace": "Trung tâm Truyền thông và Trải nghiệm Việc làm sinh viên"}
{"pattern": "\\bTT\\.\\s*TN-VLSV\\b", "replace": "Trung tâm Trải nghiệm Việc làm sinh viên"}
{"pattern": "\\bTN-VLSV\\b", "replace": "Trải nghiệm Việc làm sinh viên"}
{"pattern": "\\bTT\\.\\s*TT-TV\\b", "replace": "Trung tâm Thông tin Thư viện"}
